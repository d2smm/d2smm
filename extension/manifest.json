{
  "manifest_version": 3,
  "name": "D2 Survivors Mod Loader",
  "version": "2.9.7",
  "minimum_chrome_version": "111",
  "description": "Start the in-page mod manager. Installed mods and settings stay in the website's own storage.",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://d2survivors.lol/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "D2 Mods",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://d2survivors.lol/play/*"
      ],
      "js": [
        "generated/bootstrap.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://d2survivors.lol/play/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
