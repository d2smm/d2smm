    "runeword-enigma",
    "runeword-phoenix",
    "runeword-dream",
    "runeword-pride",
    "runeword-faith"
  ],
  "capabilities": [
    "loot-labels",
    "loot-keep-override",
    "game-audio"
  ],
  "defaults": {
    "enabled": true,
    "protectMatches": true,
    "sound": true,
    "testFcr": false
  },
  "description": "Strict elite magic/rare rules, perfect War Traveler, and selected high-end runewords. Common-item testing is off by default.",
  "extraRules": [
    {
      "id": "test-magic-fcr",
      "reason": "Test rule: magic item with 10%+ FCR",
      "toggle": "testFcr",
      "when": {
        "all": [
          {
            "field": "rarity",
            "op": "eq",
            "value": "magic"
          },
          {
            "op": "gte",
            "stat": "fcr",
            "value": 10
          }
        ]
      }
    }
  ],
  "format": "d2-survivors.mod",
  "id": "loot-guard",
  "name": "Loot Guard",
  "origin": "https://d2survivors.lol",
  "pathPrefix": "/play/",
  "schemaVersion": 1,
  "version": "1.5.0"
}
