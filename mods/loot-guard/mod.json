    "head-staffmod",
    "head-visionary",
    "boots-trires",
    "boots-resists",
    "boots-fortune",
    "belt-life-resists",
    "belt-strength",
    "body-survival",
    "body-skills",
    "shield-skills",
    "shield-block",
    "shield-staffmod",
    "weapon-cruel-speed",
    "weapon-exceptional-ed",
    "weapon-fools",
    "weapon-caster",
